{
  "section": "Hébreu parlé",
  "entries": [
    {
      "he": "תַּכְלֶ'ס",
      "tr": "takhles",
      "fr": "concrètement / au fond, en vrai",
      "niveau": "B1",
      "groupe": "particules",
      "note": "de l'hébreu תַּכְלִית par le yiddish ; s'écrit souvent תכל'ס",
      "exemples": [
        {
          "he": "תַּכְלֶ'ס, אֲנִי לֹא רוֹצֶה לָלֶכֶת",
          "tr": "takhles, ani lo rotseh lalekhet",
          "fr": "franchement, je n'ai pas envie d'y aller"
        }
      ]
    },
    {
      "he": "כְּאִילּוּ",
      "tr": "ke'ilu",
      "fr": "genre / comme si",
      "niveau": "B1",
      "groupe": "particules",
      "note": "tic de langage omniprésent ; sert aussi à rapporter des paroles",
      "exemples": [
        {
          "he": "הוּא כְּאִילּוּ לֹא רוֹאֶה אוֹתִי",
