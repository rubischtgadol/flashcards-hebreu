{
  "section": "Verbes modaux",
  "entries": [
    {
      "he": "יָכוֹל",
      "tr": "yakhol",
      "fr": "pouvoir",
      "niveau": "A1",
      "exemples": [
        {
          "he": "אֲנִי יָכוֹל לָבוֹא מָחָר",
          "tr": "ani yakhol lavo machar",
          "fr": "je peux venir demain"
        }
      ],
      "note": "s'accorde : יָכוֹל / יְכוֹלָה / יְכוֹלִים / יְכוֹלוֹת. Ex. אֲנִי יָכוֹל לָלֶכֶת = je peux aller."
    },
    {
      "he": "צָרִיךְ",
      "tr": "tsarikh",
      "fr": "il faut / devoir",
      "niveau": "A1",
      "exemples": [
        {
          "he": "אֲנִי צָרִיךְ לָלֶכֶת עַכְשָׁיו",
          "tr": "ani tsarikh lalekhet 'akhshav",
          "fr": "je dois partir maintenant"
        }
      ],
      "note": "s'accorde : צָרִיךְ / צְרִיכָה / צְרִיכִים / צְרִיכוֹת. Ex. אֲנִי צָרִיךְ לָלֶכֶת = je dois y aller."
    },
    {
      "he": "מוּתָּר",
      "tr": "mutar",
      "fr": "il est permis",
      "niveau": "A2",
      "exemples": [],
      "note": "invariable. Ex. מוּתָּר לְעַשֵּׁן = il est permis de fumer."
    },
    {
      "he": "אָסוּר",
      "tr": "asur",
      "fr": "il est interdit",
      "niveau": "A2",
      "exemples": [],
      "note": "invariable. Ex. אָסוּר לְעַשֵּׁן = il est interdit de fumer."
    },
    {
      "he": "כְּדַאי",
      "tr": "kday",
      "fr": "il vaut mieux / ça vaut le coup",
      "niveau": "B1",
      "exemples": [],
      "note": "invariable. Ex. כְּדַאי לְךָ לָלֶכֶת = tu ferais mieux d'y aller."
    },
    {
      "he": "אֶפְשָׁר",
      "tr": "efshar",
      "fr": "il est possible, on peut",
      "niveau": "A1",
      "exemples": [
        {
          "he": "אֶפְשָׁר לְשַׁלֵּם בְּכַרְטִיס",
          "tr": "efshar leshalem bekartis",
          "fr": "on peut payer par carte"
        }
      ],
      "note": "impersonnel, invariable : suit un infinitif"
    },
    {
      "he": "אִי אֶפְשָׁר",
      "tr": "i efshar",
      "fr": "c'est impossible, on ne peut pas",
      "niveau": "A2",
      "exemples": [
        {
          "he": "אִי אֶפְשָׁר לִישֹׁן פֹּה",
          "tr": "i efshar lishon poh",
          "fr": "on ne peut pas dormir ici"
        }
      ]
    },
    {
      "he": "חַיָּב",
      "tr": "chayav",
      "fr": "devoir, être obligé de",
      "niveau": "A2",
      "exemples": [
        {
          "he": "אֲנִי חַיָּב לָלֶכֶת עַכְשָׁיו",
          "tr": "ani chayav lalekhet 'akhshav",
          "fr": "je dois partir maintenant"
        }
      ],
      "note": "s'accorde : חַיָּב / חַיֶּבֶת / חַיָּבִים / חַיָּבוֹת"
    },
    {
      "he": "נִדְמֶה",
      "tr": "nidmeh",
      "fr": "il semble",
      "niveau": "B1",
      "exemples": [
        {
          "he": "נִדְמֶה לִי שֶׁהוּא צוֹדֵק",
          "tr": "nidmeh li shehu tsodek",
          "fr": "il me semble qu'il a raison"
        }
      ],
      "note": "impersonnel : נִדְמֶה לִי שֶׁ… « il me semble que… »"
    }
  ]
}
