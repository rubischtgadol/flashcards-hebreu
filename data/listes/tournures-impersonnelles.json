{
  "section": "Tournures impersonnelles",
  "entries": [
    {
      "he": "קַר לִי",
      "tr": "kar li",
      "fr": "j'ai froid",
      "niveau": "A1",
      "exemples": [
        {
          "he": "קַר לִי בַּחוּץ הַיּוֹם",
          "tr": "kar li bachuts hayom",
          "fr": "j'ai froid dehors aujourd'hui"
        }
      ]
    },
    {
      "he": "חַם לִי",
      "tr": "cham li",
      "fr": "j'ai chaud",
      "niveau": "A1",
      "exemples": [
        {
          "he": "חַם לִי בַּחֶדֶר הַזֶּה",
          "tr": "cham li bacheder hazeh",
          "fr": "j'ai chaud dans cette pièce"
        }
      ]
    },
    {
      "he": "כּוֹאֵב לִי",
      "tr": "koev li",
      "fr": "j'ai mal",
      "niveau": "A2",
      "exemples": [
        {
          "he": "כּוֹאֵב לִי הָרֹאשׁ עַכְשָׁיו",
          "tr": "koev li harosh 'akhshav",
          "fr": "j'ai mal à la tête maintenant"
        }
      ]
    },
    {
      "he": "נָעִים לִי",
      "tr": "na'im li",
      "fr": "je me sens bien",
      "niveau": "B1",
      "exemples": [
        {
          "he": "נָעִים לִי לָשֶׁבֶת כָּאן",
          "tr": "na'im li lashevet kan",
          "fr": "je me sens bien assis ici"
        }
      ]
    },
    {
      "he": "קָשֶׁה לִי",
      "tr": "kasheh li",
      "fr": "c'est dur pour moi",
      "niveau": "A2",
      "exemples": [
        {
          "he": "קָשֶׁה לִי לְהָבִין אֶת זֶה",
          "tr": "kasheh li lehavin et zeh",
          "fr": "c'est dur pour moi de comprendre ça"
        }
      ]
    },
    {
      "he": "בָּא לִי",
      "tr": "ba li",
      "fr": "j'ai envie (fam.)",
      "niveau": "A2",
      "exemples": [
        {
          "he": "בָּא לִי לִישׁוֹן עַכְשָׁיו",
          "tr": "ba li lishon 'akhshav",
          "fr": "j'ai envie de dormir maintenant"
        }
      ]
    },
    {
      "he": "מִתְחַשֵּׁק לִי",
      "tr": "mitchashek li",
      "fr": "j'ai envie de",
      "niveau": "B1",
      "exemples": [
        {
          "he": "מִתְחַשֵּׁק לִי מַשֶּׁהוּ מָתוֹק",
          "tr": "mitchashek li mashehu matok",
          "fr": "j'ai envie de quelque chose de sucré"
        }
      ]
    },
    {
      "he": "נִמְאַס לִי",
      "tr": "nim'as li",
      "fr": "j'en ai assez",
      "niveau": "B1",
      "exemples": [
        {
          "he": "נִמְאַס לִי מֵהָעֲבוֹדָה הַזֹּאת",
          "tr": "nim'as li meha'avodah hazot",
          "fr": "j'en ai assez de ce travail"
        }
      ]
    },
    {
      "he": "אִכְפַּת לִי",
      "tr": "ikhpat li",
      "fr": "ça m'importe",
      "niveau": "B1",
      "exemples": [
        {
          "he": "אִכְפַּת לִי מִמְּךָ מְאֹד",
          "tr": "ikhpat li mimkha me'od",
          "fr": "je tiens beaucoup à toi"
        }
      ]
    },
    {
      "he": "אֵין לִי כֹּחַ",
      "tr": "ein li koach",
      "fr": "j'ai la flemme (fam.)",
      "niveau": "B1",
      "exemples": [
        {
          "he": "אֵין לִי כֹּחַ לְבַשֵּׁל הַיּוֹם",
          "tr": "ein li koach levashel hayom",
          "fr": "j'ai la flemme de cuisiner aujourd'hui"
        }
      ]
    },
    {
      "he": "מַגִּיעַ לִי",
      "tr": "magi'a li",
      "fr": "je le mérite / j'y ai droit",
      "niveau": "B1",
      "exemples": [
        {
          "he": "מַגִּיעַ לִי חֹפֶשׁ אָרֹךְ",
          "tr": "magi'a li chofesh arokh",
          "fr": "je mérite de longues vacances"
        }
      ]
    },
    {
      "he": "מַסְפִּיק לִי",
      "tr": "maspik li",
      "fr": "ça me suffit",
      "niveau": "A2",
      "exemples": [
        {
          "he": "זֶה מַסְפִּיק לִי לְהַיּוֹם",
          "tr": "zeh maspik li lehayom",
          "fr": "ça me suffit pour aujourd'hui"
        }
      ]
    }
  ]
}
