      "exemples": [
        {
          "he": "אֲנִי אוֹהֵב פֵּרוֹת, לְמָשָׁל תַּפּוּחִים",
          "tr": "ani ohev perot, lemashal tapuchim",
          "fr": "j'aime les fruits, par exemple les pommes"
        }
