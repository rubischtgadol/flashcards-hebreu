    {
      "he": "כְּלוֹמַר",
      "tr": "klomar",
      "fr": "c'est-à-dire",
      "niveau": "B1",
      "exemples": [
        {
          "he": "הוּא בָּא מָחָר, כְּלוֹמַר בְּיוֹם רְבִיעִי",
          "tr": "hu ba machar, klomar beyom revi'i",
          "fr": "il vient demain, c'est-à-dire mercredi"
        }
      ]
    },
    {
      "he": "לְמָשָׁל",
      "tr": "lemashal",
      "fr": "par exemple",
