#!/bin/sh
# Tripwires au commit (lot du 2026-07-25) — la version longue est dans TODO.md § Rituel.
# Installation, une fois par machine :   git config core.hooksPath .githooks
# Bypass assumé (rare, à justifier dans le message de commit) : git commit --no-verify

set -e
cd "$(git rev-parse --show-toplevel)"

# 1. Les cinq artefacts générés doivent être en phase avec data/ + src/ — attrape à la
#    fois « j'ai édité data/ ou src/ sans relancer node tools/build.js » et « j'ai édité un
#    artefact généré à la main » (piège n°1).
echo "[pre-commit] node tools/build.js --check"
node tools/build.js --check >/dev/null

# 2. Zéro erreur bloquante sur les exemples (piège n°9 ; les warnings restent éditoriaux).
echo "[pre-commit] node tools/verifie_exemples.js"
node tools/verifie_exemples.js >/dev/null

# 3. RETIRÉ au Task 19 (chantier 4), et c'est le contrôle n°1 qui en hérite. Ce tripwire de
#    transition exigeait un bump manuel de VERSION dans sw.js dès qu'un fichier servi
#    changeait (piège n°10). VERSION est désormais ESTAMPILLÉE par `node tools/build.js` —
#    un hash des cinq artefacts + manifest.webmanifest — et `--check` recalcule ce hash :
#    un artefact committé sans son estampille échoue donc déjà au contrôle n°1, sans qu'on
#    ait à deviner la liste des fichiers servis dans une regex de shell.
#    ⚠️ Ce que plus rien ne contrôle, assumé : icons/ n'entre pas dans le hash. Une icône
#    changée n'incrémente donc pas VERSION — conséquence bornée, le fetch handler étant en
#    stale-while-revalidate (l'icône arrive avec un lancement de retard). Pour forcer une
#    vraie purge de cache, changer à la main le préfixe de `CACHE` dans sw.js.

echo "[pre-commit] OK"
