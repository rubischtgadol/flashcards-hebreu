#!/bin/sh
# Tripwires au commit (lot du 2026-07-25) — la version longue est dans TODO.md § Rituel.
# Installation, une fois par machine :   git config core.hooksPath .githooks
# Bypass assumé (rare, à justifier dans le message de commit) : git commit --no-verify

set -e
cd "$(git rev-parse --show-toplevel)"

# 1. Les quatre artefacts générés doivent être en phase avec data/ + src/ — attrape à la
#    fois « j'ai édité data/ ou src/ sans relancer node build.js » et « j'ai édité un
#    artefact généré à la main » (piège n°1).
echo "[pre-commit] node build.js --check"
node build.js --check >/dev/null

# 2. Zéro erreur bloquante sur les exemples (piège n°9 ; les warnings restent éditoriaux).
echo "[pre-commit] node verifie_exemples.js"
node verifie_exemples.js >/dev/null

# 3. Piège n°10 : un fichier servi qui change doit s'accompagner d'un bump de VERSION dans
#    sw.js, dans le même commit (stale-while-revalidate : sans bump, l'ancien fichier est
#    servi une fois de plus au prochain lancement). Tripwire de transition — le Task 19
#    (chantier 4) fera estampiller VERSION par le build et rendra ce contrôle inutile.
staged=$(git diff --cached --name-only)
if printf '%s\n' "$staged" | grep -qE '^(app\.html|flashcards_hebreu\.html|vocabulaire_hebreu\.html|index\.html|cards\.json|manifest\.webmanifest|sw\.js|icons/)'; then
  if ! git diff --cached -U0 -- sw.js | grep -q '^+const VERSION'; then
    echo "✗ [pre-commit] un fichier servi change sans bump de VERSION dans sw.js (piège n°10)."
    echo "  Bump VERSION dans sw.js et re-stage — ou bypass assumé : git commit --no-verify"
    exit 1
  fi
fi

echo "[pre-commit] OK"
